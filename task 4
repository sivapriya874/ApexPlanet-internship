</section>

<section id="contact">
  <h2>📬 Contact Me</h2>

  <input type="text" id="c-name" placeholder="Your Name">
  <input type="email" id="c-email" placeholder="Your Email">
  <textarea id="c-msg" placeholder="Your Message"></textarea>

  <button onclick="submitContact()">Send Message</button>

  <p id="contact-ok"></p>
